# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cacique_analytics
DB_USER=postgres
DB_PASSWORD=your_password_here

# Application user (for app-level queries)
APP_DB_USER=cacique_app
APP_DB_PASSWORD=your_password_here

# X (Twitter) API
X_API_KEY=your_key_here
X_API_SECRET=your_secret_here
X_ACCESS_TOKEN=your_token_here
X_ACCESS_SECRET=your_token_secret_here

# SofaScore API (if using their paid tier)
SOFASCORE_API_KEY=optional

# Python version
PYTHON_PATH=C:\Users\PC\AppData\Local\Programs\Python\Python312\python.exe
