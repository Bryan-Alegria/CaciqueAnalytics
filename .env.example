# Variables de entorno para CaciqueAnalytics
# Copia este archivo a .env y completa los valores reales
# NUNCA commites .env — está en .gitignore

# PostgreSQL Local (usuario de aplicación cacique_app)
PG_HOST=localhost
PG_PORT=5432
PG_DB=cacique_analytics
PG_USER=cacique_app
PG_PASSWORD=

# Supabase (opcional, para futuro backend cloud)
SUPABASE_URL=
SUPABASE_KEY=

# Configuración de aplicación (opcional)
APP_ENV=development
LOG_LEVEL=INFO
